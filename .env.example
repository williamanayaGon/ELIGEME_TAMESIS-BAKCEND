# Copia este archivo como .env y completa los valores.
# En Render estas variables se definen en la pestaña Environment.

# --- Base de datos ---
DATABASE_URL="postgresql://usuario:clave@host/basedatos?sslmode=require"

# --- Sesiones ---
# OBLIGATORIA. Sin ella el servidor no arranca, para no firmar sesiones
# con un valor por defecto que cualquiera pueda adivinar.
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# --- Puerto ---
# En local, 4000. En Render NO la definas: la plataforma la inyecta sola.
PORT=4000

# --- Correo (Gmail con contraseña de aplicación) ---
MAIL_USER=
MAIL_PASS=

# --- CORS ---
# Origen del frontend, sin barra al final. Separa varios con comas.
# Local:      http://localhost:5173
# Producción: https://<tu-app>.vercel.app
FRONTEND_URL="http://localhost:5173"

# --- Asistente de IA ---
OPENROUTER_API_KEY=
